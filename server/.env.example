DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/spendwise"
JWT_SECRET="replace-with-a-secure-secret"
JWT_EXPIRES_IN=7d
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Optional AI Configuration (Gemini / OpenAI / Groq)
# If left empty, SpendWise uses its built-in deterministic financial reasoning engine
AI_PROVIDER=gemini
AI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=

