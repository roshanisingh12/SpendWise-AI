DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spendwise_db
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Optional AI Configuration (Gemini / OpenAI / Groq)
# If left empty, SpendWise uses its built-in deterministic financial reasoning engine
AI_PROVIDER=gemini
AI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL=

